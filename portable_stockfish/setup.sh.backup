#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
echo 'Installing Ubuntu prerequisites (Python, Tkinter, Stockfish)…'
sudo apt update
sudo apt install -y python3 python3-venv python3-tk stockfish fonts-dejavu-core
python3 -m venv .venv
.venv/bin/python -m pip install --upgrade pip
.venv/bin/python -m pip install -r requirements.txt
ENGINE_SYS="$(command -v stockfish || true)"
if [[ -z "$ENGINE_SYS" && -x /usr/games/stockfish ]]; then ENGINE_SYS=/usr/games/stockfish; fi
if [[ -z "$ENGINE_SYS" ]]; then echo 'Stockfish executable missing' >&2; exit 1; fi
mkdir -p engine games
cp "$ENGINE_SYS" engine/stockfish
chmod +x engine/stockfish
printf 'uci\nquit\n' | ./engine/stockfish | grep -q 'uciok' || { echo 'Stockfish UCI check failed' >&2; exit 1; }
echo "Installed $(./engine/stockfish --version 2>/dev/null | head -n 1 || true)"
echo 'Done. Launch with ./run.sh'
